# Sistema de Ficha de Vida del Bombero
# Configuración Apache .htaccess

# Habilitar reescritura de URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ficha_bombero/
    
    # Redirigir a HTTPS (descomentando las siguientes líneas en producción)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Proteger archivos de configuración
<FilesMatch "^(config\.php|auth\.php|\.htaccess)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteger directorio SQL
<DirectoryMatch "sql">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>

# Proteger directorio de logs
<DirectoryMatch "logs">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>

# Configuración de seguridad
<IfModule mod_headers.c>
    # Prevenir clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Prevenir MIME sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Habilitar XSS protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Configuración de PHP
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 128M
    php_value post_max_size 10M
    php_value upload_max_filesize 10M
</IfModule>

# Habilitar compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Cache de archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes

# Página de error personalizada
ErrorDocument 404 /ficha_bombero/404.php
ErrorDocument 403 /ficha_bombero/403.php
ErrorDocument 500 /ficha_bombero/500.php
